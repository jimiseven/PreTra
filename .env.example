# ====================================================================
# PRETRA - CONFIGURACIÓN DE ENTORNO
# ====================================================================

# Entorno general
NODE_ENV=development
TIMEZONE=America/La_Paz

# Puertos
API_PORT=3001
WEB_PORT=3000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://pretra_user:pretra_password@localhost:5432/pretra_db?schema=public"

# En Docker Compose
# DATABASE_URL="postgresql://pretra_user:pretra_password@postgres:5432/pretra_db?schema=public"

# Binance Futures (USDⓈ-M Endpoints Públicos)
BINANCE_FUTURES_REST_URL="https://fapi.binance.com"
BINANCE_FUTURES_WS_URL="wss://fstream.binance.com/market"

# Reglas de negocio y detector
MAX_DAILY_SYMBOLS=5
DEFAULT_BACKFILL_DAYS=7
CANDLE_RETENTION_DAYS=30
DETECTOR_ALGO_VERSION="1.0.0"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
